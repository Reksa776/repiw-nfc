NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Copy the complete URI from Supabase Dashboard > Connect. Choose a connection
# mode for your host: direct (persistent IPv6), session pooler (IPv4 persistent),
# or transaction pooler (serverless). Do not use the redacted example literally.
# Keep this server-only; never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
PG_POOL_SIZE=5
# Use a random secret with at least 32 bytes.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Optional independent 32+ byte key for encrypting inactive activation codes at rest.
# If unset, SESSION_SECRET is used. Keep this value stable or old codes cannot be shown again.
ACTIVATION_CODE_ENCRYPTION_KEY=
DEMO_MODE=true
# Enable only behind a trusted reverse proxy which overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional, separate Supabase database used only by Playwright end-to-end tests.
# Never set this to the production connection string.
REPIW_TEST_DATABASE_URL=
# Optional legacy source used only for `npm run db:import-mysql -- demo` or
# `npm run db:import-mysql -- production`. MySQL is not used by app runtime.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_DEMO_DATABASE=
MYSQL_SSL=false

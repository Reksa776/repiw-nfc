NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Required: generate a cryptographically random secret with at least 32 bytes.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# true selects MYSQL_DEMO_DATABASE; false selects MYSQL_DATABASE.
DEMO_MODE=true
# MySQL connection. Create both databases first and grant this user access to both.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=repiw_app
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=repiw
MYSQL_DEMO_DATABASE=repiw_demo
MYSQL_POOL_SIZE=10
# Set true only when your MySQL server has TLS configured with a trusted certificate.
MYSQL_SSL=false
# Enable only behind a trusted reverse proxy which overwrites X-Forwarded-For.
TRUST_PROXY=false

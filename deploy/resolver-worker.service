# REPIW resolver worker — systemd unit for a SEPARATE long-running host.
#
# The Vercel deployment runs only the Next.js app and never starts Chromium. This unit is what
# consumes the `resolution_jobs` queue, so the resolver can be enabled without touching the
# serverless app.
#
# Install:
#   sudo cp deploy/resolver-worker.service /etc/systemd/system/repiw-resolver.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now repiw-resolver
#   systemctl status repiw-resolver
#   journalctl -u repiw-resolver -f
#
# Health (same host, as the service user). The worker exposes no port; readiness is
# observed through the heartbeat row and the --check probe:
#   npm run resolver:worker:check     # exit 0 healthy, 1 unhealthy, 2 kill switch on
#
# Requirements on this host: Node >= 22.5, the repo + `npm ci`, Chromium installed
# (npx playwright install --with-deps chromium, or google-chrome-stable), >= 2 GB free RAM
# per concurrent job (measured peak: 1.55 GB), outbound HTTPS to Google only.
#
# ExecStart uses `node --import tsx` (a single process) instead of `npm run`, so SIGTERM reaches
# the worker directly: it finishes the current job, removes its heartbeat row, and exits.

[Unit]
Description=REPIW Google Maps resolver worker (headless Chromium, one job at a time)
Documentation=file:/srv/repiw-app/docs/NFC-HOTFIX-VERCEL-RESOLVER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=repiw
WorkingDirectory=/srv/repiw-app
EnvironmentFile=/srv/repiw-app/.env
# Kill switch + queue consumer flags must be set in the EnvironmentFile:
#   PLAYWRIGHT_RESOLVER_ENABLED=1
#   DATABASE_URL=postgresql://...        (same database as the Vercel app)
#   RESOLVER_MAX_CONCURRENCY=1
#   PLAYWRIGHT_BROWSER_PATH=/usr/bin/google-chrome-stable (optional)
ExecStart=/usr/bin/node --import tsx scripts/resolver-worker.ts
Restart=always
RestartSec=5
# A job may run up to RESOLVER_TIMEOUT_MS (45 s default) before shutdown completes.
KillSignal=SIGTERM
TimeoutStopSec=90
# The resolver is the only process on this host allowed to run Chromium.
MemoryMax=3G
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

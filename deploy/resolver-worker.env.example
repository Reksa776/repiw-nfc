# REPIW resolver worker — environment template for the EXTERNAL worker host.
#
# Copy to a private root-owned file, fill in real values, then point the systemd unit at it:
#   sudo install -m 600 deploy/resolver-worker.env.example /srv/repiw-app/.env
#   sudoedit /srv/repiw-app/.env
#
# Never commit the filled file. systemd EnvironmentFile syntax: one KEY=value per line,
# no inline comments, no shell expansion. A value may be quoted if it contains spaces.

# REQUIRED — the SAME PostgreSQL database used by the Vercel app.
# Use a persistent/session connection (direct or session pooler), not a transaction pooler:
# the worker holds a connection and relies on FOR UPDATE SKIP LOCKED.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Global kill switch. Keep at 0 until migrations 6-8 and the worker health check are verified.
# Set to 1 only with explicit production approval.
PLAYWRIGHT_RESOLVER_ENABLED=0

# One job at a time is the measured-safe default (peak Chromium RSS 1.34-1.55 GB).
# Do not raise without measuring on the target host.
RESOLVER_MAX_CONCURRENCY=1
RESOLVER_TIMEOUT_MS=45000
RESOLVER_HEADLESS=true
RESOLVER_POLL_MS=2000

# Optional: explicit Chromium binary. Auto-detects common paths when empty.
PLAYWRIGHT_BROWSER_PATH=/usr/bin/google-chrome-stable

# Optional. NOT required: the resolver works from Google Maps traffic without any Google API key.
# GOOGLE_MAPS_API_KEY=

# Log level for Node (systemd captures stdout/stderr in the journal).
NODE_ENV=production
